# 이 파일을 .env로 복사한 뒤 환경에 맞게 수정하세요.
NDT_ENVIRONMENT=development
NDT_LOG_LEVEL=INFO
NDT_LOG_FILE=logs/network-diagnostic.log
NDT_CORS_ALLOWED_ORIGINS=[]
NDT_TRUSTED_PROXY_IPS=[]
NDT_DEFAULT_HTTP_TIMEOUT_SECONDS=5
NDT_MAX_HTTP_TIMEOUT_SECONDS=10
NDT_DEFAULT_TCP_TIMEOUT_SECONDS=3
NDT_MAX_TCP_TIMEOUT_SECONDS=10
NDT_MAX_REDIRECTS=5
NDT_MAX_RESPONSE_BYTES=1000000
NDT_MAX_CONCURRENT_DIAGNOSTICS=20
NDT_RATE_LIMIT_PER_MINUTE=30
NDT_ALLOWED_TCP_PORTS=[22,53,80,443,5432,3306,6379,8080]
NDT_ALLOW_PRIVATE_TARGETS=false
NDT_ALLOWED_TARGET_DOMAINS=[]

NDT_DATABASE_ENABLED=false
NDT_DIAGNOSTIC_PERSISTENCE_ENABLED=false
NDT_DATABASE_URL=postgresql://netprobe_app:CHANGE_ME@127.0.0.1:5432/netprobe
NDT_DATABASE_POOL_SIZE=10
NDT_DATABASE_MAX_OVERFLOW=10
NDT_DATABASE_POOL_TIMEOUT_SECONDS=5
NDT_DATABASE_STATEMENT_TIMEOUT_MS=5000
NDT_DIAGNOSTIC_RETENTION_DAYS=90
NDT_AUDIT_RETENTION_DAYS=180
NDT_AUTH_AUDIT_RETENTION_DAYS=365
NDT_STORE_RAW_CLIENT_IP=false

NDT_AUTH_ENABLED=false
NDT_SESSION_COOKIE_NAME=__Host-netprobe_session
NDT_CSRF_COOKIE_NAME=netprobe_csrf
NDT_SESSION_IDLE_MINUTES=30
NDT_SESSION_ABSOLUTE_HOURS=8
NDT_ADMIN_SESSION_ABSOLUTE_HOURS=4
NDT_MAX_SESSIONS_PER_USER=5
NDT_LOGIN_MAX_FAILURES=5
NDT_LOGIN_LOCK_MINUTES=15
NDT_PASSWORD_HISTORY_COUNT=5
# 로컬 HTTP에서는 false, HTTPS 운영 환경에서는 반드시 true
NDT_COOKIE_SECURE=false

# 실제 값은 Git에 올리지 마세요.
NDT_CLIENT_HASH_SECRET=
NDT_SESSION_TOKEN_PEPPER=
NDT_PASSWORD_PEPPER=
NDT_APP_VERSION=1.1.0
