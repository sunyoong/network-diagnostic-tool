# 이 파일을 .env로 복사하여 사용하세요.
# app/core/config.py의 Settings는 NDT_ 접두사가 붙은 환경변수를 읽습니다.

NDT_ENVIRONMENT=production
NDT_LOG_LEVEL=INFO

# CORS: 프론트엔드를 FastAPI와 분리 배포할 때만 설정 (콤마 구분 JSON 배열 형식)
NDT_CORS_ALLOWED_ORIGINS=[]

# X-Forwarded-For를 신뢰할 프록시의 IP 목록 (콤마 구분 JSON 배열 형식)
NDT_TRUSTED_PROXY_IPS=[]

# 타임아웃 기본값/상한 (초)
NDT_DEFAULT_HTTP_TIMEOUT_SECONDS=5
NDT_MAX_HTTP_TIMEOUT_SECONDS=10
NDT_DEFAULT_TCP_TIMEOUT_SECONDS=3
NDT_MAX_TCP_TIMEOUT_SECONDS=10

# 리다이렉트/응답 크기 제한
NDT_MAX_REDIRECTS=5
NDT_MAX_RESPONSE_BYTES=1000000

# 동시 진단 수 제한 (세마포어)
NDT_MAX_CONCURRENT_DIAGNOSTICS=20

# 분당 요청 횟수 제한 (클라이언트 IP 기준)
NDT_RATE_LIMIT_PER_MINUTE=30

# 공개 서비스에서 허용할 TCP 포트 목록
NDT_ALLOWED_TCP_PORTS=[22,53,80,443,5432,3306,6379,8080]

# 사설망 대상 진단 허용 여부. 사내 인증된 사용자 전용 배포에서만 true로 설정하세요.
NDT_ALLOW_PRIVATE_TARGETS=false

# 진단 대상 도메인 화이트리스트 (비어있으면 전체 허용, 콤마 구분 JSON 배열 형식)
NDT_ALLOWED_TARGET_DOMAINS=[]
